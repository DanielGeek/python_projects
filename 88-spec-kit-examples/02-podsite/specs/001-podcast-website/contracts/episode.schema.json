{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episode.schema.json",
  "title": "Episode collection",
  "description": "The full mocked episode list: exactly 20 episodes, exactly one featured.",
  "type": "array",
  "minItems": 20,
  "maxItems": 20,
  "items": { "$ref": "#/$defs/episode" },
  "contains": {
    "type": "object",
    "properties": { "featured": { "const": true } },
    "required": ["featured"]
  },
  "minContains": 1,
  "maxContains": 1,
  "$defs": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "description",
        "publishedAt",
        "durationSeconds",
        "guests",
        "topics",
        "featured"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 20 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "format": "date" },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "guests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "featured": { "type": "boolean" }
      }
    }
  }
}
