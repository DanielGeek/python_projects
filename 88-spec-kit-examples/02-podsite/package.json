    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "serve": "^14.2.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
