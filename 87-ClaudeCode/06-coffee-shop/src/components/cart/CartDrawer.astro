---
---

<div
	id="cart-overlay"
	data-open="false"
	class="pointer-events-none fixed inset-0 z-[60] bg-black/55 opacity-0 transition-opacity duration-300 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100"
>
</div>

<aside
	id="cart-drawer"
	data-open="false"
	aria-label="Carrito"
	aria-hidden="true"
	class="fixed top-0 right-0 bottom-0 z-[70] flex w-[min(420px,100%)] translate-x-full flex-col border-l border-foam/10 bg-cup transition-transform duration-[350ms] ease-[cubic-bezier(.2,.8,.2,1)] data-[open=true]:translate-x-0"
>
	<div class="flex items-center justify-between border-b border-foam/10 px-6 py-5">
		<h3 class="text-2xl">Tu carrito</h3>
		<button
			type="button"
			id="close-cart"
			aria-label="Cerrar carrito"
			class="grid size-11 cursor-pointer place-items-center rounded-full transition-colors hover:bg-charcoal focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-caramel"
		>
			<svg class="size-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>
	<div id="shipping-bar" class="border-b border-foam/10 px-6 py-4 text-[13px] text-foam/70"></div>
	<div id="cart-items" class="flex-1 overflow-y-auto px-6 py-2"></div>
	<div id="cart-foot" class="flex flex-col gap-3 border-t border-foam/10 px-6 pt-5 pb-6" hidden></div>
</aside>
