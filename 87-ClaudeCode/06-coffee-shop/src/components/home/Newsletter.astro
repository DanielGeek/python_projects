---
---

<section class="pb-24">
	<div class="wrap">
		<div class="news-bg grid grid-cols-2 items-center gap-x-14 gap-y-8 rounded-3xl p-14 max-[860px]:grid-cols-1 max-[860px]:px-6 max-[860px]:py-9">
			<div>
				<h2 class="text-[clamp(28px,3.6vw,42px)]">Llévate un <em class="text-caramel">10%</em> en tu primera compra</h2>
				<p class="mt-3 text-foam/80">
					Nuevos lotes, recetas y acceso anticipado a ediciones limitadas. Un correo al mes, nada más.
				</p>
			</div>

			<form id="news-form" class="group flex flex-col gap-2" data-state="" novalidate>
				<label for="email" class="text-[13px] font-medium">Tu correo electrónico</label>
				<div class="flex gap-2.5 max-[560px]:flex-col">
					<input
						id="email"
						type="email"
						placeholder="nombre@correo.com"
						autocomplete="email"
						class="h-[52px] min-w-0 flex-1 rounded-full border-[1.5px] border-foam/25 bg-cup/35 px-[22px] text-base text-foam transition-colors outline-none placeholder:text-foam/50 hover:border-foam/45 focus:border-caramel group-data-[state=error]:border-clay group-data-[state=ok]:border-caramel"
					/>
					<button type="submit" id="news-button" class="btn-primary max-[560px]:w-full">Quiero mi 10%</button>
				</div>
				<span
					id="news-message"
					class="min-h-5 text-[13px] text-foam/70 group-data-[state=error]:text-clay-text group-data-[state=ok]:text-caramel"
					aria-live="polite">Puedes darte de baja cuando quieras.</span
				>
			</form>
		</div>
	</div>
</section>
