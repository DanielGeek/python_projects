---
const benefits = [
	{
		title: 'Tueste fresco',
		text: 'Tostamos cada martes y viernes',
		icon: '<path d="M20 6c3 4-2 6 0 10M14 9c2 3-1 4 0 7M26 9c2 3-1 4 0 7"/><path d="M8 20h24v4a10 10 0 0 1-10 10h-4A10 10 0 0 1 8 24v-4Z"/><path d="M32 22h2a3 3 0 0 1 0 6h-3"/>',
	},
	{
		title: 'Envío gratis',
		text: 'En pedidos desde $40',
		icon: '<path d="M4 12h20v16H4zM24 17h7l5 5v6H24"/><circle cx="11" cy="30" r="3"/><circle cx="30" cy="30" r="3"/>',
	},
	{
		title: 'Origen directo',
		text: 'Pagamos 40% sobre comercio justo',
		icon: '<circle cx="20" cy="20" r="14"/><path d="M6 20h28M20 6c4 4 6 9 6 14s-2 10-6 14c-4-4-6-9-6-14s2-10 6-14Z"/>',
	},
	{
		title: 'Satisfacción garantizada',
		text: 'Si no te gusta, lo cambiamos',
		icon: '<path d="M20 5l12 5v9c0 8-5 13-12 16C13 32 8 27 8 19v-9l12-5Z"/><path d="M14 20l4 4 8-8"/>',
	},
];
---

<div class="bg-charcoal py-9">
	<ul class="wrap m-0 grid list-none grid-cols-4 gap-6 p-0 max-[1080px]:grid-cols-2 max-[560px]:grid-cols-1 max-[560px]:gap-[18px]">
		{
			benefits.map((b) => (
				<li class="flex items-center gap-4">
					<svg class="size-9 flex-none text-caramel" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={b.icon} />
					<div>
						<b class="block text-[15px] font-semibold">{b.title}</b>
						<span class="text-[13px] text-foam/70">{b.text}</span>
					</div>
				</li>
			))
		}
	</ul>
</div>
