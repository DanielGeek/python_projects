---
---

<section
	id="inicio"
	class="relative grid min-h-[calc(100svh-72px)] grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] overflow-hidden max-[860px]:min-h-0 max-[860px]:grid-cols-1"
>
	<div
		class="relative z-[2] flex flex-col justify-center gap-7 py-20 pr-12 pl-[max(1.5rem,calc((100vw-1200px)/2+1.5rem))] max-[860px]:-mt-[72px] max-[860px]:px-6 max-[860px]:pt-0 max-[860px]:pb-14 max-[560px]:px-4 max-[560px]:pb-12"
	>
		<h1 class="text-[clamp(42px,6vw,80px)]">
			Café de origen,<br /><em class="font-medium text-caramel italic">tostado</em> para tu taza.
		</h1>
		<p class="max-w-[40ch] text-lg text-foam/70">
			Granos de especialidad comprados directo a productores y tostados en pequeños lotes. Llega a tu puerta en su punto.
		</p>
		<div class="flex flex-wrap items-center gap-3.5">
			<a href="#tienda" class="btn-primary">
				Comprar café
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M5 12h14M13 6l6 6-6 6"></path>
				</svg>
			</a>
			<a href="#suscripcion" class="btn-secondary">Ver suscripción</a>
		</div>
	</div>

	<div class="relative max-[860px]:order-first max-[860px]:h-[56vh] max-[860px]:min-h-[340px]">
		<img
			src="/images/coffee.jpg"
			alt="Taza negra con latte art en forma de tulipán sobre una mesa de madera"
			class="absolute inset-0 size-full object-cover object-[50%_45%] saturate-[1.05] contrast-[1.05]"
			fetchpriority="high"
		/>
		<div class="hero-fade absolute inset-0"></div>
		<div
			class="absolute right-7 bottom-7 z-[2] flex max-w-[290px] items-center gap-3.5 rounded-[14px] border border-foam/10 bg-cup/80 px-[18px] py-3.5 backdrop-blur-sm max-[860px]:hidden"
		>
			<span class="size-2.5 flex-none rounded-full bg-caramel shadow-[0_2px_8px_rgb(212_172_102/0.45)]"></span>
			<div>
				<small class="block text-xs text-foam/50">Hoy en la taza</small>
				<b class="text-sm font-semibold">Huila, Colombia · notas de caramelo y naranja</b>
			</div>
		</div>
	</div>
</section>
