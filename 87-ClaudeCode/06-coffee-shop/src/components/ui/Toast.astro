---
---

<div
	id="toast"
	data-open="false"
	role="status"
	aria-live="polite"
	class="fixed bottom-6 left-1/2 z-[80] flex w-max max-w-[calc(100%-2rem)] -translate-x-1/2 translate-y-[140%] items-center gap-3.5 rounded-[14px] bg-foam py-3 pr-3.5 pl-[18px] text-sm text-cup shadow-[0_18px_40px_rgb(0_0_0/0.4)] transition-transform duration-[350ms] ease-[cubic-bezier(.2,.9,.3,1.2)] data-[open=true]:translate-y-0"
>
	<span class="grid size-[26px] flex-none place-items-center rounded-full bg-walnut text-caramel">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M5 12l5 5 9-10"></path>
		</svg>
	</span>
	<span id="toast-text">Añadido al carrito</span>
	<button
		type="button"
		id="toast-action"
		class="cursor-pointer rounded-full bg-cup px-3.5 py-2 text-[13px] font-semibold text-foam transition active:translate-y-px hover:bg-charcoal focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-walnut"
	>
		Ver carrito
	</button>
</div>
