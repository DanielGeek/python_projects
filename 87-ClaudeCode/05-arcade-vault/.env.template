# Copy this file to .env and fill in the values. Never commit .env.

# Resend API key (https://resend.com/api-keys). Server only, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives the messages sent from the /about contact form.
CONTACT_TO_EMAIL=salomons.cripto@gmail.com

# Sender shown by Resend. onboarding@resend.dev is the sandbox sender and only
# delivers to the email that owns the Resend account. Replace it once a domain is verified.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

SUPABASE_DB_PASSWORD=your_supabase_db_password_here
