# Production environment. Copy to .env.prod (git-ignored) and fill in the values. Never commit .env.prod.
# Claude is denied from reading .env.prod (see .claude/settings.json). The same values go to
# Vercel (Production environment variables). Runbook: references/production/supabase-prod-runbook.md

# Resend API key (https://resend.com/api-keys). Server only, never prefix with NEXT_PUBLIC_.
# Use a different key from the one in development.
RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives the messages sent from the /about contact form.
CONTACT_TO_EMAIL=your_inbox_here

# Sender shown by Resend. onboarding@resend.dev is the sandbox sender and only delivers to the
# email that owns the Resend account: in production use a sender of a domain verified in Resend.
CONTACT_FROM_EMAIL=Arcade Vault <hello@your-verified-domain>

# Production Supabase project (never the development one).
NEXT_PUBLIC_SUPABASE_URL=https://your_prod_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_prod_publishable_key_here

# Used only by scripts/supabase-prod.sh on your machine. Do not add these to Vercel.
SUPABASE_DB_PASSWORD=your_prod_db_password_here
# Optional: Session pooler connection string (dashboard > Connect), only if your network has no IPv6.
# SUPABASE_PROD_DB_URL=postgresql://postgres.your_prod_project_ref:password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_PROD_DB_URL=your_prod_db_url_here
